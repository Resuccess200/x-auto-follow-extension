{
  "manifest_version": 3,
  "name": "X 粉丝本地自动互关助手",
  "version": "2.0.0",
  "description": "本地自动化回关工具，适配指定主页，严格遵循滑动窗口频率限制",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}